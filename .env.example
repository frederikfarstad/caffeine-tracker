# --- Database (Turso / libSQL) ---
# Local development: a plain file, no token needed.
#   TURSO_DATABASE_URL="file:local.db"
# Production: from `turso db show ovio-buzz --url`
TURSO_DATABASE_URL="file:local.db"
# Production only: from `turso db tokens create ovio-buzz`
TURSO_AUTH_TOKEN=""

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# From Google Cloud Console -> APIs & Services -> Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Team access gate ---
# Coworkers enter this once after signing in with Google.
TEAM_JOIN_CODE="espresso-yourself"

# --- Admin bootstrap ---
# Comma-separated emails granted the admin role on first join.
ADMIN_EMAILS=""
